# Whisper model for audio transcription fallback
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Optional: nginx-proxy + Let's Encrypt (remove if not using webproxy)
VIRTUAL_HOST=yt-bridge.example.com
LETSENCRYPT_HOST=yt-bridge.example.com
LETSENCRYPT_EMAIL=you@example.com

# Optional: send YouTube traffic through a proxy (YouTube often blocks datacenter IPs)
# HTTP_PROXY=socks5h://proxy-host:1080
# HTTPS_PROXY=socks5h://proxy-host:1080
